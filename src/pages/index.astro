---
// index.astro — Single page. Two tabs: the cost calculator and the G-code analysis.
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import PrintCard from "../components/PrintCard.astro";
import MaterialCard from "../components/MaterialCard.astro";
import EnergyCard from "../components/EnergyCard.astro";
import AdvancedCard from "../components/AdvancedCard.astro";
import ResultsCard from "../components/ResultsCard.astro";
import InsightsView from "../components/InsightsView.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<Base>
  <div class="app">
    <TopBar />

    <nav class="tabs" role="tablist">
      <button class="tab is-active" data-tab="calc" role="tab" data-i18n="tab_calc">Calculadora</button>
      <button class="tab" data-tab="insights" role="tab" data-i18n="tab_insights">Análisis</button>
    </nav>

    <div class="tab-panel" data-panel="calc">
      <main class="grid">
        <section class="inputs">
          <PrintCard />
          <MaterialCard />
          <EnergyCard />
          <AdvancedCard />
        </section>
        <ResultsCard />
      </main>
    </div>

    <div class="tab-panel" data-panel="insights" hidden>
      <InsightsView />
    </div>

    <SiteFooter />
  </div>
</Base>
