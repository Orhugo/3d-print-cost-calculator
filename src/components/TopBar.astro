---
// TopBar.astro — Header: brand + language and theme buttons.
---
<header class="topbar">
  <div class="brand">
    <span class="logo">🧮</span>
    <div>
      <h1 data-i18n="h1">Costes de impresión 3D</h1>
      <p class="subtitle" data-i18n="subtitle">Calcula el coste real de tus impresiones. Todo en tu navegador.</p>
    </div>
  </div>
  <div class="topbar-actions">
    <button id="langToggle" class="icon-btn lang-btn" data-i18n-title="lang_toggle" title="Cambiar idioma">EN</button>
    <button id="themeToggle" class="icon-btn" data-i18n-title="theme_toggle" title="Cambiar tema">🌙</button>
  </div>
</header>
